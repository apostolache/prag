---
const navigation = [
  { label: 'Workshop', href: '#workshop' },
  { label: 'Questions', href: '#topics' },
  { label: 'The Team', href: '#team' }
];
---

<header class="site-header">
  <a class="brand-lockup" href="#top" aria-label="Workshop home">
    <span class="site-description">Commercial &amp; delivery transformation for Software Services in the age of AI</span>
  </a>
  <nav aria-label="Primary navigation">
    {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="contact-button" href="#contact">Contact <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<style>
  .brand-lockup {
    align-items: center;
    color: var(--ink);
    display: flex;
    flex-shrink: 0;
    gap: 12px;
    text-decoration: none;
  }

  .site-header {
    align-items: center;
    display: flex;
    gap: 20px;
    justify-content: space-between;
    padding: 24px clamp(20px, 4vw, 64px);
  }

  .site-description {
    color: var(--ink);
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    max-width: 220px;
    text-transform: uppercase;
  }

  nav { align-items: center; display: flex; gap: clamp(16px, 2.5vw, 38px); }
  nav a { align-items: center; color: var(--ink); display: inline-flex; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; min-height: 44px; text-decoration: none; text-transform: uppercase; white-space: nowrap; }
  nav a:not(.contact-button):hover { color: var(--blue); }
  .brand-lockup:focus-visible, nav a:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }

  nav a.contact-button {
    background: var(--ink);
    color: var(--paper);
    padding: 10px 13px;
  }

  .contact-button span { color: var(--red); font-size: 1rem; margin-left: 6px; }

  @media (max-width: 700px) {
    .brand-lockup { display: none; }
    .site-header { flex-wrap: wrap; gap: 12px; padding-block: 17px; }
    nav { flex-basis: 100%; gap: 8px; justify-content: space-between; }
  }
  @media (max-width: 360px) {
    nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    nav a { justify-content: center; }
  }
</style>