<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="contact-heading">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">Let's talk.</h2>
  </div>
  <form action="https://formsubmit.co/andrei.postolache@introspecials.com" method="POST" aria-labelledby="contact-title">
    <input type="hidden" name="_cc" value="emanuel.martonca@gmail.com" />
    <input type="hidden" name="_subject" value="New software services workshop enquiry" />
    <input type="hidden" name="_template" value="table" />
    <input type="text" name="_honey" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="form-fields">
      <div class="field">
        <label for="contact-name">Name</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" required />
      </div>
      <div class="field">
        <label for="contact-email">Email</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
      </div>
      <div class="field">
        <label for="contact-company">Company (optional)</label>
        <input id="contact-company" name="company" type="text" autocomplete="organization" maxlength="200" />
      </div>
      <div class="field">
        <label for="contact-focus">Your focus</label>
        <select id="contact-focus" name="workshop_focus">
          <option value="Both Commercial & Delivery">Both Commercial &amp; Delivery</option>
          <option value="Only Commercial">Commercial</option>
          <option value="Only Delivery">Delivery</option>
        </select>
      </div>
      <div class="field message-field">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" rows="6" maxlength="5000" required></textarea>
      </div>
    </div>
    <p class="privacy-note">Your details are sent via <a href="https://formsubmit.co/privacy.pdf" target="_blank" rel="noopener noreferrer">FormSubmit</a> to Andrei and Emanuel to respond to your enquiry.</p>
    <button type="submit">Send message <span aria-hidden="true">→</span></button>
  </form>
</section>

<style>
  .contact-section { display: grid; gap: 64px; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); padding: 80px clamp(20px, 4vw, 64px); }
  .eyebrow { color: var(--orange); font-size: .7rem; font-weight: 600; letter-spacing: .08em; margin: 0 0 24px; text-transform: uppercase; }
  h2 { font-size: 3.5rem; margin: 0; }
  .form-fields { display: grid; gap: 24px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .field { display: grid; gap: 10px; min-width: 0; }
  label { font-size: .8rem; font-weight: 600; }
  input, select, textarea { background: transparent; border: 1px solid var(--line-dark); border-radius: 0; color: var(--ink); font: inherit; font-size: 1rem; min-height: 48px; padding: 12px; width: 100%; }
  textarea { resize: vertical; }
  .message-field { grid-column: 1 / -1; }
  .privacy-note { font-size: .8rem; line-height: 1.6; margin: 20px 0; max-width: 62ch; }
  .privacy-note a { color: inherit; text-underline-offset: 3px; }
  button { align-items: center; background: var(--ink); border: 0; color: var(--paper); cursor: pointer; display: inline-flex; font: inherit; font-size: .8rem; font-weight: 600; gap: 24px; min-height: 48px; padding: 14px 20px; }
  button span { color: var(--orange); font-size: 1.2rem; }
  button:hover { background: var(--blue); }
  input:focus-visible, select:focus-visible, textarea:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
  .honeypot { display: none; }
  @media (max-width: 900px) { .contact-section { gap: 36px; grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .contact-section { padding-block: 48px; } h2 { font-size: 2.5rem; } }
  @media (max-width: 450px) { .form-fields { grid-template-columns: 1fr; gap: 20px; } }
</style>