---
const hosts = [
  { name: 'Andrei Postolache', role: 'Leadership, management & execution', portrait: 'andrei', image: '/pics/Andrei%20Postolache.jpeg', bio: 'Andrei is a leadership and management consultant. On PRAG, he explores how software companies organize, lead and execute as AI changes the work, with a focus on the practical realities of turning strategy into action.' },
  { name: 'Emanuel Martonca', role: 'Pricing, commercial models & value', portrait: 'specialist', image: '/pics/Manu.jpg', bio: 'Emanuel is a pricing and commercial-model specialist. On PRAG, he explores how software companies define value, price their work and rethink their commercial models as AI reshapes what clients expect and pay for.' }
];
---
<section class="hosts section" id="about" aria-labelledby="hosts-title">
  <div class="host-heading"><p class="eyebrow">Two perspectives, one industry</p><h2 id="hosts-title">The hosts</h2></div>
  <div class="host-grid">
    {hosts.map((host, index) => (
      <article class="host">
        <details class:list={['host-details', host.portrait]}>
          <summary aria-label={`${host.name}, biography`} title={`Read ${host.name}'s biography`}>
            <div class:list={['portrait', host.portrait]}>
              <img src={host.image} alt={host.name} loading="lazy" decoding="async" />
              <span class="host-number" aria-hidden="true">{index + 1}</span>
              <span class="bio-indicator" aria-hidden="true"></span>
            </div>
            <div class="host-copy"><h3>{host.name}</h3><p>{host.role}</p></div>
          </summary>
          <div class="host-bio"><p>{host.bio}</p></div>
        </details>
      </article>
    ))}
  </div>
</section>
<script is:inline>
  const hostGrid = document.querySelector('#about .host-grid');
  if (hostGrid && Math.random() < 0.5) {
    hostGrid.append(hostGrid.firstElementChild);
  }
  hostGrid?.querySelectorAll('.host-number').forEach((number, index) => {
    number.textContent = String(index + 1);
  });
</script>
<style>
  .host-details { --host-accent: var(--blue); }
  .host-details.specialist { --host-accent: var(--orange); }
  .host-details summary { cursor: pointer; list-style: none; }
  .host-details summary::-webkit-details-marker { display: none; }
  .host-details summary:focus-visible { outline: 3px solid var(--host-accent); outline-offset: 6px; }
  .portrait.portrait .bio-indicator {
    align-items: center;
    background: var(--host-accent);
    bottom: 16px;
    display: flex;
    font-size: 1.8rem;
    height: 44px;
    justify-content: center;
    left: auto;
    line-height: 1;
    padding: 0;
    right: 16px;
    top: auto;
    transition: background .15s ease, color .15s ease;
    width: 44px;
  }
  .bio-indicator::after { content: '+'; }
  .host-details[open] .bio-indicator::after { content: '-'; }
  .host-details summary:hover .bio-indicator { background: var(--paper); color: var(--ink); }
  .host-bio { border-left: 3px solid var(--host-accent); margin-top: 24px; padding: 4px 0 4px 20px; }
  .host-bio p { color: var(--paper); font-size: 1rem; line-height: 1.6; margin: 0; max-width: 56ch; }
  .host-details[open] .host-bio { animation: reveal-bio .2s ease-out; }
  @keyframes reveal-bio { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .host-details[open] .host-bio { animation: none; } .portrait.portrait .bio-indicator { transition: none; } }
  .portrait img {
    display: block;
    filter: grayscale(1);
    height: 100%;
    object-fit: cover;
    object-position: center top;
    position: absolute;
    width: 100%;
  }

  .portrait.portrait::before, .portrait.portrait::after { content: none; }
  .portrait.portrait span { background: var(--ink); padding: 7px 10px; }
  .section { padding: clamp(75px, 10vw, 140px) clamp(20px, 4vw, 64px); }.hosts { background: var(--ink); color: var(--paper); }.host-heading { display: flex; justify-content: space-between; align-items: end; padding-bottom: 23px; }.eyebrow { color: var(--blue); font-size: .67rem; font-weight: 700; letter-spacing: .1em; margin: 0; text-transform: uppercase; }.host-heading h2 { font-size: clamp(2.7rem, 5vw, 5rem); font-weight: 600; letter-spacing: -.06em; line-height: .8; margin: 0; text-transform: uppercase; }.host-grid { display: grid; gap: clamp(20px, 3vw, 50px); grid-template-columns: 1fr 1fr; margin-top: 27px; }.portrait { aspect-ratio: 1.18; background: var(--ink); overflow: hidden; position: relative; }.portrait::before { background: rgb(245 245 240 / 25%); border-radius: 49% 49% 39% 39%; content: ''; height: 64%; left: 29%; position: absolute; top: 17%; width: 41%; }.portrait::after { background: rgb(245 245 240 / 76%); border-radius: 47% 47% 43% 43%; content: ''; height: 38%; left: 37%; position: absolute; top: 23%; width: 26%; }.portrait i { background: var(--blue); height: 9px; left: 0; position: absolute; top: 61%; width: 52%; z-index: 1; }.portrait b { background: var(--red); bottom: 0; height: 30%; position: absolute; right: 17%; width: 14px; z-index: 2; }.portrait span { color: var(--paper); font-size: .65rem; font-weight: 700; left: 16px; position: absolute; top: 15px; z-index: 2; }.specialist::before { background: rgb(245 245 240 / 33%); left: 30%; top: 14%; }.specialist::after { background: rgb(245 245 240 / 82%); left: 38%; top: 20%; }.specialist i { background: var(--red); left: auto; right: 0; transform: none; }.specialist b { background: var(--blue); left: 18%; right: auto; }.host-copy { padding-top: 17px; }.host-copy h3 { font-size: clamp(1.35rem, 2.2vw, 2.25rem); font-weight: 600; letter-spacing: -.05em; line-height: .95; margin: 0; text-transform: uppercase; }.host-copy p { color: rgb(245 245 240 / 68%); font-size: .83rem; margin: 9px 0 0; }@media(max-width: 600px) { .host-heading { align-items: start; flex-direction: column; gap: 23px; }.host-grid { grid-template-columns: 1fr; } }
</style>