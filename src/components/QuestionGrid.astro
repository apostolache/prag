---
const questions = [
  'What is a software company selling when code becomes cheap?', 'Who owns the outcome?', 'What happens to the billable hour?',
  'How do you differentiate when everyone has the same AI?', 'What happens to the software team?',
  'What does a manager actually manage when AI does more of the work?', 'How do you price value you cannot yet measure?'
];
---
<section class="questions section" id="topics" aria-labelledby="questions-title">
  <div class="section-heading"><p class="eyebrow">Extract the signal from the noise</p><h2 id="questions-title">The questions behind the transformation</h2></div>
  <div class="question-grid">
    {questions.map((question, index) => <article class:list={['question', index % 3 === 1 ? 'red-accent' : 'blue-accent']}><span>0{index + 1}</span><h3>{question}</h3></article>)}
  </div>
</section>
<script is:inline>
  document.querySelectorAll('#topics .question').forEach((question) => {
    const orange = Math.random() < 0.5;
    question.classList.toggle('red-accent', orange);
    question.classList.toggle('blue-accent', !orange);
  });
</script>
<style>
  .questions { background: var(--ink); color: var(--paper); }
  .section { padding: clamp(36px, 4vw, 60px) clamp(20px, 4vw, 64px); }
  .section-heading { max-width: 780px; }
  .eyebrow { color: var(--red); font-size: .67rem; font-weight: 700; letter-spacing: .11em; margin: 0 0 14px; text-transform: uppercase; }
  h2 { font-size: clamp(1.8rem, 3vw, 3rem); font-weight: 600; letter-spacing: -.06em; line-height: .88; margin: 0; text-transform: uppercase; }
  .question-grid { display: grid; gap: 10px; grid-template-columns: repeat(4, 1fr); margin-top: 24px; }
  .question { align-content: start; background: rgb(245 245 240 / 7%); display: grid; gap: 10px; grid-template-columns: 18px 1fr; min-height: 160px; padding: 20px 16px 25px; position: relative; }
  .question::after { bottom: 0; content: ''; height: 9px; left: 0; position: absolute; width: 52px; }
  .blue-accent::after { background: var(--blue); } .red-accent::after { background: var(--red); }
  .question span { color: rgb(245 245 240 / 55%); font-size: .62rem; font-weight: 700; letter-spacing: .08em; padding-top: 4px; }
  .question h3 { font-size: clamp(1.1rem, 1.55vw, 1.55rem); font-weight: 500; letter-spacing: -.035em; line-height: 1; margin: 0; text-transform: uppercase; }
  @media (max-width: 820px) { .question-grid { grid-template-columns: repeat(2, 1fr); } .question { min-height: 130px; } }
  @media (max-width: 450px) { .question-grid { grid-template-columns: 1fr; } .question { min-height: 0; padding: 16px 16px 22px; } }
</style>